# Vendor material: every user supplies their own copy; never commit it.
original/
# screenshots/framebuffers of the original firmware (vendor graphics)
tools/scenarios/reference/
# ST datasheet: link to st.com instead of republishing
docs/hardware/DS_*.pdf
# Spooky2 content (preset files, databases, waveform CSVs, captures): read from the
# user's own install only, never committed. The one stated exception is derived data:
# the two tables in src/nx/data/, made from preset files (docs/nx/THIRD_PARTY.md)
*.s2d
Preset Collections/
*.dmslog8
*.dmslog

# Local only (by choice)
docs/hardware/photos/

# Device data (SPI-flash dumps, serial captures)
backups/
capture/

# Build output and local environments
build/
.env
.venv/
__pycache__/
.DS_Store
node_modules/
site/dist/
# release files the site build collects (from GitHub Releases, or from build/release)
site/public/firmware/

# nx UI asset sources (fonts, icon font, licences): downloaded by `make nx-assets-fetch`,
# pinned by SHA-256 in assets/nx/sources.json, never committed
assets/nx/third_party/

# Personal build settings (e.g. where your Spooky2 installation keeps its presets, for
# `make nx-data`): read by the Makefile, never committed
local.mk
